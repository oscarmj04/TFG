# ==========================================
# 🍇 .gitignore para TFG Viticultura (PyTorch + MLflow)
# ==========================================

# 1. Archivos de Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# 2. Entornos Virtuales (Conda / Venv)
env/
venv/
.env

# 3. Datos e Imágenes de Entrenamiento
# Ignoramos el dataset masivo para no saturar GitHub
data/train/*
data/val/*
!data/train/.keep
!data/val/.keep

# 4. Registros y MLflow
mlruns/
*.db
mlflow.db
alembic/

# 5. Salidas generadas automáticamente por tu código
matriz_confusion.png

# 6. Archivos del Sistema Operativo (Windows/Mac)
.DS_Store
Thumbs.db
desktop.ini

# 7. Archivos de IDEs (VS Code, PyCharm, etc.)
.vscode/
.idea/
*.swp